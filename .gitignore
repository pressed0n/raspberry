node_modules/
.next/
out/
data/
.env
.env.*
!.env.example
*.tsbuildinfo
test-results/
playwright-report/
artifacts/
# Session artifacts, never truth. PLAN.md is written by the planning tool, is accurate only
# until the plan ships, and then contradicts docs/STATE.md — which is exactly what happened:
# a committed PLAN.md claimed "395 tests, AGENTS.md is 129 lines" while both had moved on.
# The durable version of "what is next" is docs/STATE.md. git rm --cached PLAN.md keeps it.
PLAN.md
*.log
# Agent scratch probes. One-off measurement scripts accumulate every session; they are
# never part of the app. Promoted tools get a real name (`read-spec-page.mjs`) and are
# tracked; anything still called `tmp-*` is throwaway.
#
# They live in `scripts/scratch/` so `scripts/` holds only the tools that exist as tools,
# and so `git status` means "code changed" instead of "an agent measured something". Nothing
# in scratch/ is imported by the app; it is kept on disk only because a verification run is
# evidence, and re-running it costs a browser session. New browser probes should import the
# tracked `scripts/browser-session.mjs` instead of copying the old boilerplate.
scripts/tmp-*
scripts/probe-*
scripts/scratch/
# Local push credentials (SSH key / token material) — never commit
.secrets/
# Portable Node toolchain used to run the suite on the dev laptop — never commit
.tools/
# Agent harness state — never commit
.unjess/

.vercel
.env*
