# Raspberry has two access modes. Only one of them serves data at a time.
#
#   local   - loopback only. Selected by `pnpm dev` and `pnpm preview`, which set
#             RASPBERRY_LOCAL_DEV=1 for you.
#   session - the hosted path (public domain + TLS + Google sign-in + emailed code).
#             Requires every variable in the block below. `pnpm start` refuses to boot
#             if any of them is missing, rather than starting a server nobody can reach
#             or everybody can.
RASPBERRY_AUTH_MODE=local

# --- session mode -----------------------------------------------------------------
# Google OAuth client. In the Google console the authorised redirect URI must be
# exactly RASPBERRY_PUBLIC_ORIGIN + /api/auth/google/callback — no trailing slash.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# The canonical public origin. Must be https: a Secure cookie and an OAuth code over
# plaintext are refused, not warned about.
# RASPBERRY_PUBLIC_ORIGIN=https://raspberry.example.com

# Who may sign in. Required, comma separated, and an empty list means "nobody" — there
# is no configuration in which this file leaves the door open.
# RASPBERRY_ALLOWED_EMAILS=you@example.com

# The address that adopts the notes already on this machine (see SECURITY.md). Leave
# unset on a fresh deployment; set it to your address when you move an existing
# data/raspberry.sqlite to a hosted install, or those notes stay unreachable.
# RASPBERRY_OWNER_EMAIL=you@example.com

# How login codes are delivered. `http` POSTs {from,to,subject,text} as JSON to
# RASPBERRY_MAIL_URL with an optional bearer token — point it at your provider's API or
# a small relay of your own. `console` prints to stderr and is refused in production
# unless RASPBERRY_MAIL_ALLOW_CONSOLE=1, because a service log holding live login codes
# is an account takeover for anyone who can read the log.
# RASPBERRY_MAIL_BACKEND=http
# RASPBERRY_MAIL_FROM=raspberry@example.com
# RASPBERRY_MAIL_URL=https://relay.example.com/send
# RASPBERRY_MAIL_TOKEN=

# Trust X-Forwarded-For / X-Forwarded-Proto, but only from a proxy you control. Set this
# behind Caddy or nginx; without it the rate limiter sees every caller as one address.
# RASPBERRY_TRUST_PROXY=1

# Host header values accepted in addition to RASPBERRY_PUBLIC_ORIGIN's host, and extra
# browser origins allowed to make requests (a second custom domain).
# RASPBERRY_TRUSTED_HOSTS=
# RASPBERRY_EXTRA_ORIGINS=

# Bind address used by `pnpm start`. Keep it on loopback and put a TLS proxy in front.
# RASPBERRY_HOST=127.0.0.1

# Default: file:./data/raspberry.sqlite
# Optional PostgreSQL: postgres://raspberry:YOUR_PASSWORD@localhost:5432/raspberry
DATABASE_URL=file:./data/raspberry.sqlite
