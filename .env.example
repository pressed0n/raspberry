# Raspberry has two access modes. Only one of them serves data at a time.
#
#   local   - loopback only. Selected by `pnpm dev` and `pnpm preview`, which set
#             RASPBERRY_LOCAL_DEV=1 for you.
#   session - the hosted path (public domain + TLS + emailed sign-in code).
#             Requires every variable in the block below. `pnpm start` refuses to boot
#             if any of them is missing, rather than starting a server nobody can reach
#             or everybody can.
RASPBERRY_AUTH_MODE=local

# --- session mode -----------------------------------------------------------------
# Sign-in is an emailed six-digit code, and the account has to exist as well as being
# allowlisted: see `pnpm accounts`. Two required things are the origin and a way to send
# mail; Google is optional.
#
# Google OIDC as an extra factor, off unless both halves are present. With them set the
# challenge is bound to the Google subject before the code is emailed; without them the
# code is the whole door and `/api/auth/google/start` answers 503 by itself. If you do set
# this, the authorised redirect URI in the Google console must be exactly
# RASPBERRY_PUBLIC_ORIGIN + /api/auth/google/callback — no trailing slash.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# The canonical public origin. Must be https: a Secure cookie and an OAuth code over
# plaintext are refused, not warned about.
# RASPBERRY_PUBLIC_ORIGIN=https://raspberry.example.com

# Who may sign in. Required, comma separated, and an empty list means "nobody" — there
# is no configuration in which this file leaves the door open. This is only the outer
# gate: an address on it still needs an `accounts` row, which `pnpm accounts` creates.
# RASPBERRY_ALLOWED_EMAILS=you@example.com

# The address that adopts the notes already on this machine (see SECURITY.md). Leave
# unset on a fresh deployment; set it to your address when you move an existing
# data/raspberry.sqlite to a hosted install, or those notes stay unreachable. The same
# value is what `pnpm accounts --adopt` uses.
# RASPBERRY_OWNER_EMAIL=you@example.com

# How login codes are delivered. `http` POSTs {from,to,subject,text} as JSON to
# RASPBERRY_MAIL_URL with an optional bearer token — point it at your provider's API or
# a small relay of your own. `console` prints to stderr and is refused in production
# unless RASPBERRY_MAIL_ALLOW_CONSOLE=1, because a service log holding live login codes
# is an account takeover for anyone who can read the log.
# RASPBERRY_MAIL_BACKEND=http
# RASPBERRY_MAIL_FROM=raspberry@example.com
# RASPBERRY_MAIL_URL=https://relay.example.com/send
# RASPBERRY_MAIL_TOKEN=

# `smtp` hands the message to nodemailer: port 465 is implicit TLS, 587 upgrades with
# STARTTLS. This is the option that reaches any recipient without owning a domain — a
# shared/sandbox sender (Resend's onboarding@resend.dev, for instance) will only deliver
# to the provider account's own address. Gmail uses smtp.gmail.com:587 with an App
# Password, which needs 2FA turned on and is not the account's normal password.
# RASPBERRY_MAIL_BACKEND=smtp
# RASPBERRY_SMTP_HOST=smtp.gmail.com
# RASPBERRY_SMTP_PORT=587
# RASPBERRY_SMTP_USER=you@example.com
# RASPBERRY_SMTP_PASS=

# Where uploaded bytes live. Unset means `data/uploads/<sha256>` on this machine, which
# is right for `pnpm dev`. Hosted, a disk is per-instance and wiped on cold start, so
# object storage is required: set these and every blob goes to the bucket instead. The
# access key is the credential's token id and the secret is its s3 secret key.
# Keys are `w/<workspace>/<sha256>`, so uploads are content-addressed and scoped.
# RASPBERRY_S3_ENDPOINT=https://<branch>.storage.<region>.aws.neon.tech
# RASPBERRY_S3_BUCKET=raspberry-uploads
# RASPBERRY_S3_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Trust X-Forwarded-For / X-Forwarded-Proto, but only from a proxy you control. Set this
# behind Caddy or nginx; without it the rate limiter sees every caller as one address.
# RASPBERRY_TRUST_PROXY=1

# Host header values accepted in addition to RASPBERRY_PUBLIC_ORIGIN's host, and extra
# browser origins allowed to make requests (a second custom domain).
# RASPBERRY_TRUSTED_HOSTS=
# RASPBERRY_EXTRA_ORIGINS=

# Bind address used by `pnpm start`. Keep it on loopback and put a TLS proxy in front.
# RASPBERRY_HOST=127.0.0.1

# --- the outbound requests this app makes ------------------------------------------
# Raspberry talks to two computers that are not yours, both of them optional, both of them
# through the *server* rather than through each browser, and both off with one word.
#
# A Place cell searches for addresses, and that search is the only time Raspberry asks somebody
# else a question. It goes through the server (src/server/places.ts), so the provider sees this
# machine rather than each browser:
#
#   unset        Photon (photon.komoot.io) — free, no key, and built for search-as-you-type
#   off          no network at all. A Place cell becomes a text field that still stores
#                exactly what you type; it just cannot look anything up.
#   http://...   any geocoder that speaks GeoJSON: a self-hosted Photon or Nominatim (note
#                that OSM's policy forbids auto-complete on the public Nominatim), or the
#                loopback fixture the place probe runs against.
#
# RASPBERRY_PLACES_URL=off

# A cell that holds a picked *place* shows a map of it, and the map is made of OpenStreetMap's
# 256px squares. Those come through the server too (src/server/tiles.ts), for the same reason:
# an <img> pointed at a tile server would tell that server which address somebody just picked,
# four times per cell, with a browser user-agent — the exact traffic OSM's tile policy exists to
# stop. The browser only ever names a square of the world, `/api/places/tile?z&x&y`.
#
#   unset        tile.openstreetmap.org
#   off          no map. The card still opens, still shows the pin on its own background, and
#                says the tiles are switched off rather than pretending the map is broken.
#   http://...   any slippy-map server, or the loopback fixture the map probe runs against.
#
# Attribution is part of the licence: the card renders "© OpenStreetMap contributors" linked to
# openstreetmap.org/copyright. Do not remove it while these tiles are being used.
#
# The card also has a corner arrow that leaves the app, and that one is not a request Raspberry
# makes: it is a link a person presses, opening Google Maps in a new tab with the coordinate in
# the query. Nothing is sent unless somebody asks to see the place in Google Maps, and there is
# nothing to configure — it is a plain href, not a fetch.
#
# Nothing else in Raspberry makes an outbound request: no telemetry, no font CDN, no
# analytics. These two variables are the only ones that could change that.
# RASPBERRY_TILES_URL=off

# Default: file:./data/raspberry.sqlite
# Optional PostgreSQL: postgres://raspberry:YOUR_PASSWORD@localhost:5432/raspberry
DATABASE_URL=file:./data/raspberry.sqlite
