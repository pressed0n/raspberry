# Raspberry has two access modes. Only "local" can serve data today.
#
#   local   - loopback only. Selected by `pnpm dev` and `pnpm preview`.
#   session - the hosted path (public domain + TLS + Google sign-in + email code).
#             The transport checks exist and are tested, but every request is
#             refused until session authentication is implemented. This mode is
#             a reviewed seam, not a working feature.
RASPBERRY_AUTH_MODE=local

# Local mode. Do not expose this through a tunnel; the guard rejects any
# non-loopback Host header, so a tunnel will simply fail.
RASPBERRY_LOCAL_DEV=1
APP_ORIGIN=http://localhost:3000

# Hosted mode only, and inert until sessions exist.
# RASPBERRY_PUBLIC_ORIGIN=https://raspberry.mashina.ai   # bare https origin, no path
# RASPBERRY_TRUSTED_HOSTS=                               # extra Host values, comma separated
# RASPBERRY_EXTRA_ORIGINS=                               # extra https origins, comma separated
# RASPBERRY_REQUIRE_HTTPS=1                              # 0 only to test a local TLS proxy
# RASPBERRY_TRUST_PROXY=0                                # 1 to key rate limits on X-Forwarded-For
# RASPBERRY_HOST=127.0.0.1                               # bind address used by `pnpm start`

# Default: file:./data/raspberry.sqlite
# Optional local PostgreSQL: postgres://raspberry:YOUR_PASSWORD@localhost:5432/raspberry
DATABASE_URL=file:./data/raspberry.sqlite
